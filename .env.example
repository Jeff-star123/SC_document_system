# Copy to .env (or export these) before running the application.
# Never commit real credentials.

# --- Database (MySQL 8.x) ---------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/school_document_request?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Manila&characterEncoding=UTF-8
DB_USER=sjc_app
DB_PASSWORD=change-me
DB_POOL_SIZE=10

# --- Web server -------------------------------------------------------------
PORT=8080
SESSION_TIMEOUT=30m
COOKIE_SECURE=false

# --- First administrator ----------------------------------------------------
# Used once to create the initial ADMIN account on startup. Leave empty and
# use the documented SQL/CLI procedure instead if you prefer.
BOOTSTRAP_ADMIN_EMAIL=admin@sjudemanila.edu.ph
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=System
BOOTSTRAP_ADMIN_LAST_NAME=Administrator

# --- Development seed data (NEVER enable in production) ---------------------
SEED_DEMO_USERS=false
SEED_PASSWORD=

# --- Login protection -------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10
